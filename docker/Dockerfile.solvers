# Solver build image only (Ubuntu toolchain + vendor tree).
# syntax=docker/dockerfile:1

FROM ubuntu:22.04 AS solvers
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake gcc g++ make \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY vendor ./vendor
# TODO: cmake build per vendor tree; copy binaries to /opt/solvers/bin
RUN mkdir -p /opt/solvers/bin \
    && printf '%s\n' "# placeholder binaries" > /opt/solvers/bin/README.txt
